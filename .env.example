# Copy this file to .env and fill in your own Supabase project values.
# Find these in your Supabase project: Settings -> API
# NEVER put your service_role key here or anywhere in frontend code.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Web Push (browser notifications). This is the PUBLIC half of a VAPID
# keypair - safe to expose in the frontend. Generate both halves with
# `npx web-push generate-vapid-keys` (see SETUP.md) and put the PRIVATE
# key only in your Supabase Edge Function secrets, never here.
VITE_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
